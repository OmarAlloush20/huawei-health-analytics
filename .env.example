EXPO_PUBLIC_HUAWEI_AGCONNECT_CONFIGURED=false
EXPO_PUBLIC_HUAWEI_APP_CONFIGURED=false
EXPO_PUBLIC_HUAWEI_HEALTH_SCOPE_APPROVED=false
