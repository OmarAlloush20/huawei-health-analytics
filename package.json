{
  "name": "huawei-health-analytics",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@hmscore/react-native-hms-health": "6.15.0-303",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-server-dom-webpack": "19.2.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android --device",
    "android:build": "cd android && gradlew.bat assembleDebug",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:android:clean": "expo prebuild --clean --platform android",
    "verify:huawei-prebuild": "node scripts/verify-huawei-prebuild.js",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor@latest",
    "test": "jest --runInBand",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/"
    ]
  },
  "private": true
}
